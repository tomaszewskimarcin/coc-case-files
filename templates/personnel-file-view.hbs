<div class="journal-entry-page personnel-file">
    <header>
        <h1>{{document.name}}</h1>
        {{#if isGM}}
        <button type="button" data-action="toggle-edit" style="margin: 10px 0; width: 100%;">
            <i class="fas fa-edit"></i> Switch to Edit Mode
        </button>
        {{/if}}
    </header>

    {{#if document.system.role}}
    <div class="role-stamp role-{{document.system.role}}">
        {{lookup roles document.system.role}}
    </div>
    {{/if}}

    <section class="details">
        {{#each fields as |field|}}
        <div class="form-group">
            <label>{{field.label}}:</label>
            {{#if field.value}}
                <span class="value">{{field.value}}</span>
            {{else}}
                {{#if ../canPropose}}
                    <input type="text" class="player-propose" data-field="{{field.key}}" placeholder="{{localize 'COC-CASE-FILES.ProposeDetail'}}">
                {{else}}
                    <span class="value unknown">-------</span>
                {{/if}}
            {{/if}}

            {{#if ../isGM}}
                {{#if field.proposal}}
                <div class="proposal-alert">
                    <span><strong>{{localize 'COC-CASE-FILES.ProposedValue'}}</strong> {{field.proposal}}</span>
                    <div class="proposal-actions">
                        <button type="button" class="approve" data-action="approve-proposal" data-field="{{field.key}}" title="{{localize 'COC-CASE-FILES.Approve'}}"><i class="fas fa-check"></i></button>
                        <button type="button" class="reject" data-action="reject-proposal" data-field="{{field.key}}" title="{{localize 'COC-CASE-FILES.Reject'}}"><i class="fas fa-times"></i></button>
                    </div>
                </div>
                {{/if}}
            {{/if}}
        </div>
        {{/each}}
    </section>

    <section class="description">
        <h3>{{localize "COC-CASE-FILES.Description"}}</h3>
        <div class="editor-content">
            {{{document.system.description}}}
        </div>
    </section>
</div>
