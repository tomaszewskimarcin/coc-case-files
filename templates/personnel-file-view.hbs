<div class="journal-entry-page personnel-file theme-{{theme}}">
    <div class="watermark-stamp">{{watermark}}</div>

    <header class="police-header">
        <div class="header-left">
            <span class="header-org">{{headerTop}}</span>
            <span class="header-sub">{{headerSub}}</span>
        </div>
        <div class="header-right">
            <span class="file-number">SYGN: AKTA/{{document._id}}</span>
        </div>
    </header>

    <div class="dossier-top-section">
        <div class="dossier-title">
            <h1>{{#if document.system.fullName}}{{document.system.fullName}}{{else}}{{document.name}}{{/if}}</h1>
        </div>

        {{!-- Role Display & Role Proposal --}}
        <div class="role-wrapper">
            {{#if document.system.role}}
                <div class="role-stamp role-{{document.system.role}}">
                    {{lookup roles document.system.role}}
                </div>
            {{else}}
                {{#if roleProposal}}
                    <div class="pending-role-stamp">
                        <span class="pending-role-title"><i class="fas fa-hourglass-half"></i> {{localize "COC-CASE-FILES.PendingProposal"}} <strong>{{lookup roles roleProposal}}</strong></span>
                        <span class="pending-status">{{localize "COC-CASE-FILES.PendingStatus"}}</span>
                        {{#if isGM}}
                        <div class="proposal-actions inline-actions">
                            <button type="button" class="approve-btn" data-action="approve-proposal" data-field="role" title="{{localize 'COC-CASE-FILES.Approve'}}">
                                <i class="fas fa-check"></i> {{localize 'COC-CASE-FILES.Approve'}}
                            </button>
                            <button type="button" class="reject-btn" data-action="reject-proposal" data-field="role" title="{{localize 'COC-CASE-FILES.Reject'}}">
                                <i class="fas fa-times"></i> {{localize 'COC-CASE-FILES.Reject'}}
                            </button>
                        </div>
                        {{/if}}
                    </div>
                {{else}}
                    {{#if canPropose}}
                        <div class="role-propose-box">
                            <select class="role-draft-select" data-field="role">
                                <option value="" disabled {{#unless roleDraft}}selected{{/unless}}>-- {{localize "COC-CASE-FILES.Role"}} --</option>
                                <option value="suspect" {{#if (eq roleDraft "suspect")}}selected{{/if}}>{{localize "COC-CASE-FILES.Roles.suspect"}}</option>
                                <option value="witness" {{#if (eq roleDraft "witness")}}selected{{/if}}>{{localize "COC-CASE-FILES.Roles.witness"}}</option>
                                <option value="victim" {{#if (eq roleDraft "victim")}}selected{{/if}}>{{localize "COC-CASE-FILES.Roles.victim"}}</option>
                            </select>
                            <button type="button" class="submit-role-proposal-btn" data-action="submit-role-proposal">
                                <i class="fas fa-paper-plane"></i> {{localize "COC-CASE-FILES.SubmitProposal"}}
                            </button>
                        </div>
                    {{else}}
                        <div class="role-stamp unassigned-stamp">
                            {{localize "COC-CASE-FILES.UnassignedRole"}}
                        </div>
                    {{/if}}
                {{/if}}
            {{/if}}
        </div>
    </div>

    <section class="dossier-grid">
        {{#each fields as |field|}}
        <div class="dossier-field-row">
            <span class="field-label">{{field.label}}:</span>
            <div class="field-value-wrapper">
                {{#if field.isLocked}}
                    {{!-- Confirmed and Locked Value --}}
                    <span class="value confirmed-value">
                        {{field.value}}
                        <i class="fas fa-lock locked-badge" title="{{localize 'COC-CASE-FILES.LockedField'}}"></i>
                    </span>
                {{else}}
                    {{#if field.proposal}}
                        {{!-- Proposal Pending Review --}}
                        <div class="player-pending-box">
                            <span class="pending-text">
                                <i class="fas fa-hourglass-half"></i> <strong>{{localize "COC-CASE-FILES.PendingProposal"}}</strong> "{{field.proposal}}"
                                <span class="pending-status">{{localize "COC-CASE-FILES.PendingStatus"}}</span>
                            </span>

                            {{#if ../isGM}}
                            <div class="proposal-actions">
                                <button type="button" class="approve-btn" data-action="approve-proposal" data-field="{{field.key}}" title="{{localize 'COC-CASE-FILES.Approve'}}">
                                    <i class="fas fa-check"></i> {{localize 'COC-CASE-FILES.Approve'}}
                                </button>
                                <button type="button" class="reject-btn" data-action="reject-proposal" data-field="{{field.key}}" title="{{localize 'COC-CASE-FILES.Reject'}}">
                                    <i class="fas fa-times"></i> {{localize 'COC-CASE-FILES.Reject'}}
                                </button>
                            </div>
                            {{/if}}
                        </div>
                    {{else}}
                        {{#if ../canPropose}}
                            {{!-- Player Draft Input with explicit Submit Proposal Button & persisted draft --}}
                            <div class="propose-draft-group">
                                <input type="text" class="player-draft-input" data-field="{{field.key}}" value="{{field.draft}}" placeholder="{{localize 'COC-CASE-FILES.ProposeDetail'}}">
                                <button type="button" class="submit-proposal-btn" data-action="submit-proposal" data-field="{{field.key}}" title="{{localize 'COC-CASE-FILES.SubmitProposal'}}">
                                    <i class="fas fa-paper-plane"></i> {{localize "COC-CASE-FILES.SubmitProposal"}}
                                </button>
                            </div>
                        {{else}}
                            <span class="value unconfirmed-placeholder">------- [BRAK DANYCH] -------</span>
                        {{/if}}
                    {{/if}}
                {{/if}}
            </div>
        </div>
        {{/each}}
    </section>

    <section class="dossier-notes">
        {{#if descriptionHTML}}
        <div class="official-notes-section">
            <h3>{{localize "COC-CASE-FILES.OfficialDescription"}}</h3>
            <div class="editor-content notes-box">
                {{{descriptionHTML}}}
            </div>
        </div>
        {{/if}}

        <div class="player-notepad-section">
            <h3><i class="fas fa-edit"></i> {{localize "COC-CASE-FILES.PlayerNotepadTitle"}}</h3>
            <textarea class="player-notepad" data-page-id="{{document._id}}" placeholder="{{localize 'COC-CASE-FILES.PlayerNotepadPlaceholder'}}">{{playerNotepad}}</textarea>
            <span class="notepad-hint"><i class="fas fa-save"></i> {{localize "COC-CASE-FILES.PlayerNotepadHint"}}</span>
        </div>
    </section>

    <footer class="police-footer">
        <span>{{footerLeft}}</span>
        <span>{{footerRight}}</span>
    </footer>
</div>
