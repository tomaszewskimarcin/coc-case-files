<form class="fields-config-app" autocomplete="off">
    <header class="fields-config-header">
        <h2><i class="fas fa-cogs"></i> {{localize "COC-CASE-FILES.FieldsConfigTitle"}}</h2>
        <p>{{localize "COC-CASE-FILES.FieldsConfigSubtitle"}}</p>
    </header>

    <div class="fields-table-wrapper">
        <table class="fields-table">
            <thead>
                <tr>
                    <th style="width: 26%;">{{localize "COC-CASE-FILES.TableHeaderLabel"}}</th>
                    <th style="width: 24%;">{{localize "COC-CASE-FILES.TableHeaderType"}}</th>
                    <th style="width: 28%;">{{localize "COC-CASE-FILES.TableHeaderOptions"}}</th>
                    <th style="width: 8%;" class="text-center" title="{{localize 'COC-CASE-FILES.TooltipAllowProposals'}}">{{localize "COC-CASE-FILES.TableHeaderProposals"}}</th>
                    <th style="width: 7%;" class="text-center" title="{{localize 'COC-CASE-FILES.TooltipActive'}}">{{localize "COC-CASE-FILES.TableHeaderActive"}}</th>
                    <th style="width: 7%;" class="text-center">{{localize "COC-CASE-FILES.TableHeaderActions"}}</th>
                </tr>
            </thead>
            <tbody>
                {{#each fields as |field index|}}
                <tr class="field-row {{#if field.isCustom}}custom-field-row{{else}}core-field-row{{/if}}">
                    <td class="field-label-cell">
                        <input type="text" name="fields.{{index}}.label" value="{{field.displayLabel}}" required>
                        <input type="hidden" name="fields.{{index}}.key" value="{{field.key}}">
                        {{#if field.labelKey}}<input type="hidden" name="fields.{{index}}.labelKey" value="{{field.labelKey}}">{{/if}}
                    </td>
                    <td class="field-type-cell">
                        <select name="fields.{{index}}.type" class="field-type-select" data-index="{{index}}">
                            <option value="text" {{#if (eq field.type "text")}}selected{{/if}}>{{localize "COC-CASE-FILES.FieldType.text"}}</option>
                            <option value="number" {{#if (eq field.type "number")}}selected{{/if}}>{{localize "COC-CASE-FILES.FieldType.number"}}</option>
                            <option value="select" {{#if (eq field.type "select")}}selected{{/if}}>{{localize "COC-CASE-FILES.FieldType.select"}}</option>
                            <option value="date" {{#if (eq field.type "date")}}selected{{/if}}>{{localize "COC-CASE-FILES.FieldType.date"}}</option>
                            <option value="textarea" {{#if (eq field.type "textarea")}}selected{{/if}}>{{localize "COC-CASE-FILES.FieldType.textarea"}}</option>
                        </select>
                    </td>
                    <td class="field-options-cell">
                        <input type="text" name="fields.{{index}}.optionsStr" value="{{field.optionsStr}}" placeholder="{{localize 'COC-CASE-FILES.SelectOptionsPlaceholder'}}" {{#unless (eq field.type "select")}}disabled{{/unless}}>
                    </td>
                    <td class="text-center">
                        <input type="checkbox" name="fields.{{index}}.allowProposals" {{#if field.allowProposals}}checked{{/if}} title="{{localize 'COC-CASE-FILES.TooltipAllowProposals'}}">
                    </td>
                    <td class="text-center">
                        {{#if field.isCore}}
                            <input type="checkbox" name="fields.{{index}}.enabled" checked disabled title="{{localize 'COC-CASE-FILES.TooltipCoreFieldActive'}}">
                        {{else}}
                            <input type="checkbox" name="fields.{{index}}.enabled" {{#if field.enabled}}checked{{/if}} title="{{localize 'COC-CASE-FILES.TooltipActive'}}">
                        {{/if}}
                    </td>
                    <td class="text-center actions-cell">
                        {{#if field.isCustom}}
                            <button type="button" class="delete-field-btn" data-action="delete-field" data-index="{{index}}" title="{{localize 'COC-CASE-FILES.DeleteCustomField'}}">
                                <i class="fas fa-trash"></i>
                            </button>
                        {{else}}
                            <span class="core-badge"><i class="fas fa-shield-alt"></i> {{localize "COC-CASE-FILES.CoreBadge"}}</span>
                        {{/if}}
                    </td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>

    <footer class="fields-config-footer">
        <button type="button" class="add-field-btn" data-action="add-field">
            <i class="fas fa-plus"></i> {{localize "COC-CASE-FILES.AddField"}}
        </button>
        <button type="submit" class="save-config-btn">
            <i class="fas fa-save"></i> {{localize "COC-CASE-FILES.SaveConfig"}}
        </button>
    </footer>
</form>
