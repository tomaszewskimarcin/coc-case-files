<form class="personnel-file-edit-sheet flexcol" autocomplete="off">
    <div class="dossier-header-edit">
        <h2>{{localize "COC-CASE-FILES.HeaderTop"}}</h2>
        <p>{{localize "COC-CASE-FILES.HeaderSub"}}</p>
    </div>

    <fieldset>
        <legend>Dane Podstawowe</legend>
        <div class="form-group">
            <label>{{localize "COC-CASE-FILES.FullName"}}</label>
            <input type="text" name="system.fullName" value="{{document.system.fullName}}">
        </div>
        <div class="form-group">
            <label>{{localize "COC-CASE-FILES.Alias"}}</label>
            <input type="text" name="system.alias" value="{{document.system.alias}}">
        </div>
        <div class="form-group">
            <label>{{localize "COC-CASE-FILES.Gender"}}</label>
            <input type="text" name="system.gender" value="{{document.system.gender}}">
        </div>
        <div class="form-group">
            <label>{{localize "COC-CASE-FILES.Role"}}</label>
            <select name="system.role">
                {{selectOptions roles selected=document.system.role localize=true}}
            </select>
        </div>
    </fieldset>

    <fieldset>
        <legend>{{localize "COC-CASE-FILES.Appearance"}}</legend>
        <div class="form-group">
            <label>{{localize "COC-CASE-FILES.Height"}}</label>
            <input type="text" name="system.appearance.height" value="{{document.system.appearance.height}}">
        </div>
        <div class="form-group">
            <label>{{localize "COC-CASE-FILES.Build"}}</label>
            <input type="text" name="system.appearance.build" value="{{document.system.appearance.build}}">
        </div>
        <div class="form-group">
            <label>{{localize "COC-CASE-FILES.Hair"}}</label>
            <input type="text" name="system.appearance.hair" value="{{document.system.appearance.hair}}">
        </div>
        <div class="form-group">
            <label>{{localize "COC-CASE-FILES.Eyes"}}</label>
            <input type="text" name="system.appearance.eyes" value="{{document.system.appearance.eyes}}">
        </div>
        <div class="form-group">
            <label>{{localize "COC-CASE-FILES.Marks"}}</label>
            <input type="text" name="system.appearance.marks" value="{{document.system.appearance.marks}}">
        </div>
    </fieldset>

    <fieldset>
        <legend>Miejsce Zamieszkania</legend>
        <div class="form-group">
            <label>{{localize "COC-CASE-FILES.Address"}}</label>
            <input type="text" name="system.address" value="{{document.system.address}}">
        </div>
    </fieldset>

    <div class="form-group stacked">
        <label>{{localize "COC-CASE-FILES.Description"}}</label>
        {{editor editorContent target="system.description" button=true owner=owner editable=editable engine="prosemirror"}}
    </div>
</form>
